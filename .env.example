# ranimahal-backend — environment variables
#
# For each var: whether its absence is LOUD (build fails, or a request
# errors clearly) or SILENT (the feature quietly no-ops/degrades with no
# visible error). This session found two real bugs shaped exactly like a
# SILENT var behaving unexpectedly — worth knowing which category
# something falls into before assuming "it's probably fine."

# ── Payments (Stripe) — CRITICAL PATH, LOUD on missing key ──────────
# Read through a 4-name fallback chain (STRIPE_SECRET_KEY ||
# STRIPE_LIVE_SECRET_KEY || STRIPE_KEY || STRIPE_SECRET) in
# lib/syncStripe.js / api/create-checkout.js / api/create-catering-checkout.js.
# Use STRIPE_SECRET_KEY — the others exist only for backward compat and are
# a real footgun: renaming/typo-ing the intended var silently falls through
# to whichever of the four names IS set, which could be a stale key.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Auth (Clerk) — SECONDARY, gracefully degrades to guest checkout ──
# Confirmed in code: any Clerk failure/absence is caught and treated as
# "not signed in." Sign-in, saved cards, and loyalty pricing are lost;
# checkout itself keeps working.
CLERK_SECRET_KEY=sk_...
VITE_CLERK_PUBLISHABLE_KEY=pk_...

# ── Staff auth — LOUD (staff tools return 401 with no password set) ──
MANAGER_SECRET=

# ── Cron auth — LOUD by design (fails closed if unset) ───────────────
# Every api/cron/*.js checks this first and returns 401 if it's missing —
# a deliberate fix earlier this session (was previously fail-OPEN).
CRON_SECRET=

# ── Weekly encrypted order backup — LOUD (refuses to run without it) ─
# api/cron/backup-orders.js will not upload an unencrypted PII dump; it
# alerts staff and no-ops if this isn't set. Any string works — it's
# hashed into a real key, not used directly. Generate one with:
#   openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=

# ── SMS (Twilio) — SECONDARY, SILENT on failure ──────────────────────
# sendSMS/sendStaffSMS log a console.error and nothing else on failure —
# no retry, no queue, no UI-visible indication. Routine order-status texts
# and staff new-order alerts have no backup channel if Twilio is down;
# the two "customer charged but order failed" / "customer stuck at
# checkout" alerts additionally email staff, so those two survive a
# Twilio outage.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM=
RESTAURANT_EMAIL=
RESTAURANT_PHONE=

# ── Email (Resend) — SECONDARY, SILENT on failure ────────────────────
# sendEmail checks for this up front and warns+no-ops if missing; the
# actual send is wrapped in .catch() — a Resend outage means a receipt or
# status email is just gone, no retry.
RESEND_API_KEY=

# ── Error tracking (Sentry) — SECONDARY, dormant by design ───────────
# lib/sentry.js is a genuine no-op everywhere until this is set — ships
# fine without it, but there's no way to tell from the code alone whether
# it's actually configured in production. Worth confirming in the Vercel
# dashboard directly.
SENTRY_DSN=
VITE_SENTRY_DSN=

# ── Web push notifications — SECONDARY, SILENT on missing keys ───────
# lib/push.js returns false and no-ops if either key is missing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:orders@ranimahal.cc
VITE_VAPID_PUBLIC_KEY=

# ── Blog generation pipeline (Gemini + GitHub) — SECONDARY, low-stakes ──
# Internal cron-only content tool, zero customer-facing path. Both
# geminiGenerate() and the GitHub PR call return null/no-op on a missing
# key or a failed request — confirmed no partial/garbage PR can be opened
# without both succeeding.
GEMINI_API_KEY=

# GITHUB_TOKEN — a classic or fine-grained PAT scoped to `contents` on the
# ranimahal-marketing repo, used to open blog-draft PRs.
GITHUB_TOKEN=

# ── Kitchen thermal printer (print-bridge, standalone local tool) ────
# Not read by the deployed app itself — only by tools/print-bridge-package,
# which runs locally at the restaurant, not on Vercel.
PRINTER_TYPE=
PRINTER_IP=
PRINTER_PORT=
PRINTER_NAME=

# ── Misc / URLs ────────────────────────────────────────────────────
# NEXT_PUBLIC_BASE_URL — despite the Next-style name, read by THIS (Vite)
# repo's checkout success/cancel redirect. Must be this app's own domain
# (ranimahal.food), never the marketing site's — a prior bug this session
# traced to exactly this kind of mix-up in a sibling file.
NEXT_PUBLIC_BASE_URL=https://ranimahal.food
VITE_GA_MEASUREMENT_ID=
GOOGLE_WRITE_REVIEW_URL=

# API_BASE / CUSTOMER_BASE — read by the standalone print-bridge tool only,
# not the deployed Vercel app.
API_BASE=
CUSTOMER_BASE=
