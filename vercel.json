{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/sweep-abandoned-carts", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/promote-scheduled-orders", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/review-nudge", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/win-back-lapsed", "schedule": "0 16 * * *" },
    { "path": "/api/cron/second-order-push", "schedule": "0 15 * * *" },
    { "path": "/api/cron/never-ordered-nudge", "schedule": "0 17 * * *" },
    { "path": "/api/cron/catering-cross-sell", "schedule": "0 18 * * *" },
    { "path": "/api/cron/newsletter-digest", "schedule": "0 14 1 * *" },
    { "path": "/api/cron/cultural-calendar", "schedule": "0 15 * * *" },
    { "path": "/api/cron/blog-draft-check", "schedule": "0 13 * * *" }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(self)" }
      ]
    }
  ]
}
